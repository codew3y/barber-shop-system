# Database
DATABASE_URL="postgresql://barber:barber_dev@localhost:5432/barber_booking"
DIRECT_URL="postgresql://barber:barber_dev@localhost:5432/barber_booking"
REDIS_URL="redis://localhost:6379"

# Background jobs (release expired holds, send reminders, mark no-shows).
# Without one of these set, production refuses to run jobs (503) and nothing
# expires holds or sends reminders. Vercel Cron sends CRON_SECRET as a bearer
# token; external schedulers send INTERNAL_JOB_KEY as X-Internal-Key.
INTERNAL_JOB_KEY=""
CRON_SECRET=""

# Auth
JWT_SECRET="dev-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# PayMongo QR Ph (test keys — Phase 5)
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Error tracking (Sentry) — leave empty to disable locally
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Sourcemap upload (build-time only; without these the build skips upload)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Web Push (VAPID) — generate with `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
# The public key is exposed to browsers (NEXT_PUBLIC_); the private key stays server-side.
# Without these, push sending is a silent no-op.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Email notifications via SMTP (nodemailer). Without these, rows stay pending.
# Example Gmail: host smtp.gmail.com, port 587, secure false, user + 16-char app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
