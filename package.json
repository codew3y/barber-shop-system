{
  "name": "barberhouse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/with-env.mjs npm run dev -w @barberhouse/frontend",
    "build": "node scripts/with-env.mjs npm run build -w @barberhouse/frontend",
    "start": "node scripts/with-env.mjs npm run start -w @barberhouse/frontend",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "test": "npm run test -w @barberhouse/backend",
    "test:e2e": "node scripts/with-env.mjs npm run test:e2e -w @barberhouse/frontend",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx backend/prisma/seed.ts",
    "jobs": "tsx backend/scripts/jobs.ts",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "tsx backend/prisma/seed.ts"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
